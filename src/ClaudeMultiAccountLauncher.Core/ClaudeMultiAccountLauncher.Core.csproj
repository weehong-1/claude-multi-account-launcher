<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that isn't UI lives here so it can be unit tested without WinUI. -->
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>ClaudeMultiAccountLauncher.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeMultiAccountLauncher.Core.Tests" />
  </ItemGroup>

</Project>
